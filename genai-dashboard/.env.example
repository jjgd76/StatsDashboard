# ── Azure Storage (required) ──────────────────────────────────────────────────
# Use a connection string OR account name + managed identity (not both).
AZURE_STORAGE_CONNECTION_STRING=

# For managed identity / az login auth (leave blank if using connection string)
AZURE_STORAGE_ACCOUNT_NAME=

# ── Azure Key Vault (optional — production only) ──────────────────────────────
# If set, the backend loads secrets from Key Vault at startup.
KEY_VAULT_NAME=

# ── App config ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
