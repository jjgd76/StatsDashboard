# ── Mock / demo mode ──────────────────────────────────────────────────────────
# Set to true to use generated mock data instead of live API calls.
# Mock mode is also activated automatically when API keys are missing.
MOCK_DATA=true

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_ADMIN_API_KEY=

# ── OpenAI (ChatGPT) ──────────────────────────────────────────────────────────
OPENAI_ADMIN_API_KEY=

# ── Microsoft Graph (M365 Copilot) ───────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure Storage (required) ──────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=

# ── Azure Key Vault (optional — production only) ──────────────────────────────
KEY_VAULT_NAME=

# ── App config ────────────────────────────────────────────────────────────────
REFRESH_INTERVAL_HOURS=1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
REFRESH_SECRET=
